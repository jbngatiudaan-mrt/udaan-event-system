# Copy this file to .env for local runs. On Render, enter the same names under Environment instead.

# ---- Environment ----
# uat on the test site, production on the live site. UAT shows a yellow banner and allows "Delete all test data".
APP_ENV=uat

# ---- Required ----
DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-1-ap-south-1.pooler.supabase.com:5432/postgres
PUBLIC_BASE_URL=https://udaan-uat.onrender.com
SESSION_SECRET=paste-a-long-random-string-here
ADMIN_PIN=
GATE_PIN=
STAGE_PIN=

# ---- WhatsApp (Meta Cloud API). Leave WA_TOKEN blank for demo mode: messages are logged, not sent ----
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_WABA_ID=
WA_APP_SECRET=
WA_WEBHOOK_VERIFY_TOKEN=
# Your WhatsApp number in international format, digits only, e.g. 15551234567 (test number) or 919876543210
WA_BUSINESS_NUMBER=
# template = pass pushed automatically with an approved template (costs a utility message each)
# reply    = visitor taps "Get my pass on WhatsApp" and sends the pre-typed message; pass comes back free
# session  = plain messages only; for quick tests where the recipient messaged you in the last 24 h
WA_MODE=template
WA_TEMPLATE_PASS=udaan_entry_pass
WA_TEMPLATE_WINNER=udaan_lucky_draw_winner
WA_TEMPLATE_LANG=en
WA_PASS_BUTTON=false
WA_WINNER_DELAY_MS=12000

# ---- Optional ----
SHEETS_WEBHOOK_URL=
KEEPALIVE_URL=
DRAW_ROUNDS=5
TICKET_PREFIX=UDN
